{
  "sourceLanguage": "en",
  "strings": {
    "%@%@%@": {
      "comment": "Not copy: joins a name or intention, a space and the carried mark (CarriedMark.after).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@%3$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "home.bar.add": {
      "comment": "Accessibility label: the + in Home's floating bar (opens the add sheet).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "home.bar.history": {
      "comment": "Accessibility label: the history button in Home's floating bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        }
      }
    },
    "home.bar.pray": {
      "comment": "Accessibility label: the blue pray button beside Home's floating bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pray"
          }
        }
      }
    },
