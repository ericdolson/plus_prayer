{
  "sourceLanguage": "en",
  "strings": {
    "%@%@%@": {
      "comment": "Not copy: joins a name or intention, a space and the carried mark (CarriedMark.after).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@%3$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "card.closesSoon": {
      "comment": "Card: replaces the status line near the cutoff, only if you haven't prayed with the list today.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List %1$lld closes in %2$lld min · pray to carry them"
          }
        }
      }
    },
    "card.closesSoonYou": {
      "comment": "Same, when only you are carried.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List %1$lld closes in %2$lld min · pray to be on List %3$lld"
          }
        }
      }
    },
    "card.list.beingFilmed": {
      "comment": "VoiceOver: the card's seal before the list is published (unsealed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List %lld, being filmed"
          }
        }
      }
    },
    "card.list.sealed": {
      "comment": "VoiceOver: the card's seal once the list is published.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List %lld, sealed"
          }
        }
      }
    },
    "card.list.title": {
      "comment": "The community card's title, e.g. “List 52”. Always a no-break space before the number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List %lld"
          }
        }
      }
    },
    "card.overflow": {
      "comment": "The avatar row's overflow disc, e.g. “+4”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        }
      }
    },
    "card.people": {
      "comment": "Card counts row: people on the list. The number is styled separately (ink), the word muted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld person"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld people"
                }
              }
            }
          }
        }
      }
    },
    "card.prayers": {
      "comment": "Card counts row: prayers for the list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld prayer"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld prayers"
                }
              }
            }
          }
        }
      }
    },
    "card.presence.lastHour": {
      "comment": "Card presence line, short form (no dot).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld prayed this hour"
          }
        }
      }
    },
    "card.presence.lastHour.spoken": {
      "comment": "VoiceOver: the long form of “prayed this hour”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld prayed in the last hour"
          }
        }
      }
    },
    "card.presence.now": {
      "comment": "Card presence line (with the live dot). Shown only at 10 or more.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld praying now"
          }
        }
      }
    },
    "card.presence.today": {
      "comment": "Card presence line (no dot).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld prayed today"
          }
        }
      }
    },
    "card.status.covered": {
      "comment": "Card status: your carried people are already going onto the next list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll be on List %lld"
          }
        }
      }
    },
    "card.status.coveredYou": {
      "comment": "Card status when only you are carried.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be on List %lld"
          }
        }
      }
    },
    "card.status.nextPrayer": {
      "comment": "Card status: prayed with the list today, but it has flipped since.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next prayer carries them onto List %lld"
          }
        }
      }
    },
    "card.status.nextPrayerYou": {
      "comment": "Same, when only you are carried.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next prayer puts you on List %lld"
          }
        }
      }
    },
    "card.status.prayToBe": {
      "comment": "Card status when only you are carried.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pray to be on List %lld"
          }
        }
      }
    },
    "card.status.prayToCarry": {
      "comment": "Card status: the one actionable thing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pray to carry them onto List %lld"
          }
        }
      }
    },
    "home.bar.add": {
      "comment": "Accessibility label: the + in Home's floating bar (opens the add sheet).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "home.bar.history": {
      "comment": "Accessibility label: the history button in Home's floating bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        }
      }
    },
    "home.bar.pray": {
      "comment": "Accessibility label: the blue pray button beside Home's floating bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pray"
          }
        }
      }
    },
    "home.bar.search": {
      "comment": "Accessibility label: the search button in Home's floating bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        }
      }
    },
    "home.filter": {
      "comment": "Accessibility label: the filter button in Home's header (opens the filter menu).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter"
          }
        }
      }
    },
    "home.filter.all": {
      "comment": "Filter menu item: show everything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        }
      }
    },
    "home.filter.allHeld": {
      "comment": "Subtitle on the Still to hold menu item when everyone has been held today (also the empty state).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone's been held today."
          }
        }
      }
    },
    "home.filter.carried": {
      "comment": "Filter menu item: what's carried (printed on the daily list). No list number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carried"
          }
        }
      }
    },
    "home.filter.clear": {
      "comment": "Accessibility label: the × inside the active filter chip (back to All).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show all"
          }
        }
      }
    },
    "home.filter.stillToHold": {
      "comment": "Filter menu item and chip: names and intentions not yet held today.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still to hold"
          }
        }
      }
    },
    "home.filter.withCount": {
      "comment": "Filter menu item with its count, e.g. “Still to hold · 3”. Never shown at 0. %1$@ = the filter, %2$lld = the count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld"
          }
        }
      }
    },
    "home.header.streak": {
      "comment": "Accessibility label for the streak badge. 0 = no streak (no number is shown).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day with the world"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days with the world"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Days with the world"
                }
              }
            }
          }
        }
      }
    },
    "home.header.you": {
      "comment": "Accessibility label: your avatar in Home's header (opens You).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        }
      }
    }
  },
  "version": "1.0"
}
