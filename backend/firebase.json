{
  "//": "Deploys and emulators run from inside backend/. Paths are relative to this file.",
  "dataconnect": {
    "source": "dataconnect"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      "test",
      "scripts",
      "*.log"
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "database": {
      "host": "0.0.0.0",
      "port": 9000
    },
    "dataconnect": {
      "host": "0.0.0.0",
      "port": 9399
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "eventarc": {
      "port": 9299
    },
    "ui": {
      "enabled": false
    }
  }
}
